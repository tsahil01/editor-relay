{
  "name": "vscode-context-bridge",
  "displayName": "Editor Relay",
  "publisher": "sahiltiwaskar",
  "version": "2.0.0",
  "description": "Gives AI agents live VS Code editor context and language-server powered tools over MCP",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-context-bridge.startServer",
        "title": "Start Editor Relay Server",
        "category": "Editor Relay"
      },
      {
        "command": "vscode-context-bridge.stopServer",
        "title": "Stop Editor Relay Server",
        "category": "Editor Relay"
      },
      {
        "command": "vscode-context-bridge.showStatus",
        "title": "Show Server Status",
        "category": "Editor Relay"
      },
      {
        "command": "vscode-context-bridge.copyToken",
        "title": "Copy Auth Token",
        "category": "Editor Relay"
      }
    ],
    "configuration": [
      {
        "title": "Editor Relay",
        "properties": {
          "vscodeContextBridge.port": {
            "type": "number",
            "default": 3210,
            "description": "Port for the Editor Relay server"
          },
          "vscodeContextBridge.shareDiagnostics": {
            "type": "boolean",
            "default": true,
            "description": "Share diagnostics information with external processes"
          },
          "vscodeContextBridge.shareDiffs": {
            "type": "boolean",
            "default": true,
            "description": "Share diff information with external processes"
          },
          "vscodeContextBridge.ignoreFiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "node_modules",
              ".env"
            ],
            "description": "List of file or folder patterns to ignore when sharing context. Substring match."
          },
          "vscodeContextBridge.shareTerminalOutput": {
            "type": "boolean",
            "default": true,
            "description": "Share recent terminal commands and their output (requires terminal shell integration)"
          }
        }
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "vscode-context-bridge.mcp",
        "label": "Editor Relay"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ./",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js",
    "compile": "bun run typecheck && bun run bundle --sourcemap",
    "watch": "bun run bundle --sourcemap --watch",
    "package": "bun run typecheck && rm -rf dist && bun run bundle --minify && vsce package --no-dependencies",
    "bundle:test": "esbuild test/suite/*.test.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --external:mocha --outdir=out/test",
    "test": "bun run compile && bun run bundle:test && vscode-test"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.101.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsahil01/editor-relay.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/tsahil01/editor-relay/issues"
  },
  "homepage": "https://github.com/tsahil01/editor-relay#readme",
  "keywords": [
    "vscode",
    "context",
    "mcp",
    "model context protocol",
    "ai",
    "agent"
  ]
}
